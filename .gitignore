# =========================================================================
# BiteBolt Backend .gitignore
# =========================================================================

# Maven Build Target Directories
target/
**/target/

# Java Class Files
*.class

# Log files
*.log
logs/
**/logs/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Crash logs
hs_err_pid*
replay_pid*

# =========================================================================
# IDEs and Editors Configurations
# =========================================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
**/out/

# Eclipse
.metadata/
.classpath
.project
.settings/
*.launch
*.sublime-workspace

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Visual Studio Code
.vscode/

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# =========================================================================
# Project Specific Local Assets & Secrets
# =========================================================================
# Local environment configs (do not commit passwords/secrets)
*.env
*.local
**/application-local.properties
**/application-dev.properties

# Temp/Scratch files
scratch/
**/scratch/

# DB Data folders (Docker Volumes)
pgdata/
redisdata/
kafkadata/
zookeeperdata/

# Ignore agents configuration directories
.agentCoding/


# Separate configuration repository
bitebolt-config/
